# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMO_TABLE_NAME=vibe-my-life-expense
HABIT_TABLE_NAME=vibe-my-life-habit
# Create it once with: pnpm --filter backend exec tsx scripts/create-cooking-table.ts
COOKING_TABLE_NAME=vibe-my-life-cooking
# Create it once with: pnpm --filter backend exec tsx scripts/create-climbing-table.ts
CLIMBING_TABLE_NAME=vibe-my-life-climbing

# Cloudflare R2 — photos and clips attached to climbs, over R2's S3-compatible API. These
# are separate from the AWS credentials above: those reach DynamoDB, these reach R2.
# The account id is the one in your R2 endpoint, https://<account id>.r2.cloudflarestorage.com;
# the key pair comes from an R2 API token with Object Read & Write.
# Leave blank to run without uploads: the media endpoints report themselves unavailable and
# the UI hides the upload buttons.
# Set the bucket up once with: pnpm --filter backend exec tsx scripts/create-media-bucket.ts
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vibe-my-life-media
# The S3 API endpoint as the R2 dashboard prints it. Optional — it is derived from the
# account id when blank, which is right unless Cloudflare gave you a jurisdiction-specific
# host (one with `.eu.` or `.fedramp.` in it).
S3_API_ENDPOINT=

# Auth
JWT_SECRET=your-secret-key
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Server
PORT=3001
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# LLM API Keys
MIMO_API_KEY=your-mimo-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API Key — Whisper transcription, and chat completions for the recipe parser
# (qwen/qwen3.8-27b)
GROQ_API_KEY=your-groq-api-key-here

# Passkeys / Face ID login (WebAuthn). Leave both blank to disable — password
# login keeps working. RP_ID is the bare domain (no scheme, no port); RP_ORIGIN
# is a comma-separated list of https origins under that domain.
RP_ID=
RP_ORIGIN=
