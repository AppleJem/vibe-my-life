# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMO_TABLE_NAME=vibe-my-life-expense
HABIT_TABLE_NAME=vibe-my-life-habit

# Auth
JWT_SECRET=your-secret-key
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Server
PORT=3001
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# LLM API Keys
MIMO_API_KEY=your-mimo-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API Key (for voice transcription)
GROQ_API_KEY=your-groq-api-key-here
