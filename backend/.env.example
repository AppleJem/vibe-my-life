# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMO_TABLE_NAME=vibe-my-life-expense
HABIT_TABLE_NAME=vibe-my-life-habit
# Create it once with: pnpm --filter backend exec tsx scripts/create-cooking-table.ts
COOKING_TABLE_NAME=vibe-my-life-cooking

# Auth
JWT_SECRET=your-secret-key
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Server
PORT=3001
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# LLM API Keys
MIMO_API_KEY=your-mimo-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API Key — Whisper transcription, and chat completions for the recipe parser
# (qwen/qwen3.8-27b)
GROQ_API_KEY=your-groq-api-key-here

# Passkeys / Face ID login (WebAuthn). Leave both blank to disable — password
# login keeps working. RP_ID is the bare domain (no scheme, no port); RP_ORIGIN
# is a comma-separated list of https origins under that domain.
RP_ID=
RP_ORIGIN=
